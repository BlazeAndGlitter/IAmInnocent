  m_Name: 
  m_EditorClassIdentifier: 
  introText: {fileID: 915428991}
  messages:
  - Ah damn it! Not again. Why do I keep waking up in god damn CRIME SZENES?
  - They are gonna think I am a murderer. Gotta hide this stuff and put it into someone
    elses shoes before they be callling the police.
  - We were just drinking some nice tea a coiuple of hours ago... And I just f*****
    moved here.  Cant get into any trouble.
  typingSpeed: 0.05
